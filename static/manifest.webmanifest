  "categories": ["games", "entertainment", "utilities"],
  "icons": [
    { "src": "/images/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/images/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Dice", "url": "/cards#dice", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192" }] },
    { "name": "Initiative", "url": "/cards#initiative", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192" }] },
    { "name": "Quick builds", "url": "/cards#quick-builds", "icons": [{ "src": "/images/icon-192.png", "sizes": "192x192" }] }
  ]
